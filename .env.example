# ============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ----------------------------------------------------------------------------
# Como usar:
#   1. Faça uma cópia deste arquivo e renomeie para ".env"
#   2. O ".env" NÃO é enviado ao GitHub (está protegido no .gitignore)
#   3. Estas variáveis são lidas pelo Vite no navegador (prefixo VITE_)
#
# IMPORTANTE: só coloque aqui chaves PÚBLICAS.
#   - A chave "anon"/publishable do Supabase é pública por design (pode ficar aqui).
#   - Chaves SECRETAS (Stripe, OpenAI, VAPID privada) NÃO ficam aqui —
#     elas vão nos "Secrets" das Edge Functions no painel do Supabase.
# ============================================================================

# ID do projeto Supabase (a parte antes de ".supabase.co" na URL)
VITE_SUPABASE_PROJECT_ID="ktymjadbggzxvjbefquw"

# URL base da API do seu projeto Supabase
VITE_SUPABASE_URL="https://ktymjadbggzxvjbefquw.supabase.co"

# Chave pública (anon) usada pelo app no navegador para falar com o Supabase.
# É pública por design e protegida pelas regras de RLS do banco.
VITE_SUPABASE_PUBLISHABLE_KEY="cole_aqui_a_chave_anon_do_seu_projeto_supabase"
